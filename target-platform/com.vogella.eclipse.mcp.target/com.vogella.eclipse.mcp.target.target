<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?pde version="3.8"?>
<target name="com.vogella.eclipse.mcp.target" sequenceNumber="1">
  <locations>
    <!-- Local p2 mirror published offline from the STM32CubeIDE V2 install (Eclipse 4.38).
         Avoids reaching download.eclipse.org, which is unreachable from this machine. -->
    <location includeAllPlatforms="false" includeConfigurePhase="true" includeMode="planner" includeSource="false" type="InstallableUnit">
      <unit id="org.eclipse.core.runtime" version="0.0.0"/>
      <unit id="org.eclipse.core.resources" version="0.0.0"/>
      <unit id="org.eclipse.search.core" version="0.0.0"/>
      <unit id="org.eclipse.cdt.core" version="0.0.0"/>
      <unit id="org.eclipse.cdt.dsf" version="0.0.0"/>
      <unit id="org.eclipse.cdt.dsf.gdb" version="0.0.0"/>
      <unit id="org.eclipse.ui" version="0.0.0"/>
      <unit id="org.eclipse.jface" version="0.0.0"/>
      <unit id="org.eclipse.debug.core" version="0.0.0"/>
      <unit id="org.eclipse.debug.ui" version="0.0.0"/>
      <repository location="file:/D:/tools/hardware/CubeIDE-p2repo"/>
    </location>
    <location includeDependencyDepth="infinite" includeDependencyScopes="compile" includeSource="true"
              label="MCP Java SDK" missingManifest="generate" type="Maven">
      <dependencies>
        <dependency>
          <groupId>io.modelcontextprotocol.sdk</groupId>
          <artifactId>mcp</artifactId>
          <version>2.0.0</version>
          <type>jar</type>
        </dependency>
      </dependencies>
    </location>
    <location includeDependencyDepth="infinite" includeDependencyScopes="compile" includeSource="true"
              label="Jetty" missingManifest="generate" type="Maven">
      <dependencies>
        <dependency>
          <groupId>org.eclipse.jetty.ee11</groupId>
          <artifactId>jetty-ee11-servlet</artifactId>
          <version>12.1.12</version>
          <type>jar</type>
        </dependency>
        <dependency>
          <groupId>jakarta.servlet</groupId>
          <artifactId>jakarta.servlet-api</artifactId>
          <version>6.1.0</version>
          <type>jar</type>
        </dependency>
      </dependencies>
    </location>
    <!-- slf4j.api 2.x needs an slf4j binding that provides the
         osgi.serviceloader=org.slf4j.spi.SLF4JServiceProvider capability.
         The CubeIDE-bundled slf4j-nop is 1.x and lacks it, so pull 2.x. -->
    <location includeDependencyDepth="infinite" includeDependencyScopes="compile" includeSource="false"
              label="SLF4J NOP binding" missingManifest="generate" type="Maven">
      <dependencies>
        <dependency>
          <groupId>org.slf4j</groupId>
          <artifactId>slf4j-nop</artifactId>
          <version>2.0.17</version>
          <type>jar</type>
        </dependency>
      </dependencies>
    </location>
  </locations>
</target>
